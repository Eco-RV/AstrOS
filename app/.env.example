# Copied to app/.env automatically on `npm start` / `npm run doctor`.
# app/.env is gitignored: never commit it.

# Which section of environments.toml the Scaffold CLI uses.
# `development` = deploy your contracts to TESTNET on every save.
STELLAR_SCAFFOLD_ENV=development

# Where the Scaffold/Stellar CLI keeps identities and contract ids for this project
# (relative to app/, gitignored).
XDG_CONFIG_HOME=".config"

# ── Frontend (only PUBLIC_* vars reach the browser) ────────────────────────────
# Network: TESTNET | PUBLIC (mainnet) | FUTURENET | LOCAL. Invalid values silently fall back to LOCAL.
PUBLIC_STELLAR_NETWORK="TESTNET"
PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
PUBLIC_STELLAR_RPC_URL="https://soroban-testnet.stellar.org"
PUBLIC_STELLAR_HORIZON_URL="https://horizon-testnet.stellar.org"

# Cavos embedded wallets (optional): users sign in with email/Google and get a
# Stellar wallet without installing an extension. Leave empty to only offer
# extension wallets. https://cavos.xyz/dashboard → create app → copy App ID, then
# add http://localhost:5173 to the app's allowed web origins (+ callback URLs for Google).
PUBLIC_CAVOS_APP_ID=""
# Cavos console environment: development | production
PUBLIC_CAVOS_ENVIRONMENT="development"

# AstrOS: id of the event highlighted on the home page (the class demo). Empty = none.
PUBLIC_FEATURED_EVENT_ID=""
# IPFS gateway used to show event images stored as ipfs://<CID>.
PUBLIC_IPFS_GATEWAY="https://ipfs.io"

# Mainnet (real money), only when you know what you're doing:
# PUBLIC_STELLAR_NETWORK="PUBLIC"
# PUBLIC_STELLAR_NETWORK_PASSPHRASE="Public Global Stellar Network ; September 2015"
# PUBLIC_STELLAR_RPC_URL="https://<your-mainnet-rpc-provider>"
# PUBLIC_STELLAR_HORIZON_URL="https://horizon.stellar.org"
